  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43123 --strictPort",
    "build": "tsc -b && vite build",
    "build:offline": "vite build --config vite.config.offline.ts",
